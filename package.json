{
  "name": "express-demo",
  "version": "1.0.0",
  "description": "GitLab webhook-based code review system with AI integration",
  "main": "dist/index.js",
  "private": true,
  "keywords": ["express", "gitlab", "webhook", "ai", "code-review", "typescript"],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start pm2.json",
    "stop": "pm2 stop pm2.json",
    "restart": "pm2 restart pm2.json",
    "reload": "pm2 reload pm2.json",
    "list": "pm2 list",
    "logs": "pm2 logs",
    "logs:error": "pm2 logs --err",
    "clean": "rm -rf dist && rm -rf node_modules/.cache",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "docker build -t express-demo .",
    "docker:run": "docker run -d -p 4399:4399 --name express-demo-container --env-file .env express-demo",
    "docker:stop": "docker stop express-demo-container",
    "docker:remove": "docker rm express-demo-container",
    "docker:logs": "docker logs -f express-demo-container",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "docker:clean": "docker system prune -f",
    "health-check": "curl -f http://localhost:4399/health || exit 1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jade": "^1.11.0",
    "morgan": "^1.10.0",
    "openai": "^4.98.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "pm2": "^6.0.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "volta": {
    "node": "20.11.0",
    "pnpm": "8.15.0"
  }
}
